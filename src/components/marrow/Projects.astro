---
/* marrowtech — the showcase grid (ported from design_system hub/Projects.jsx).
   Five projects, each styled to match its site. */
import SectionMarker from './SectionMarker.astro';
import ProjectCard from './ProjectCard.astro';
---

<section class="hub-section" id="work">
  <div class="hub-section-head">
    <SectionMarker index="01" label="Work" kana="作品" />
    <p class="hub-section-lead">
      Five things I've built and maintain — from idea to production. Click to visit.
    </p>
  </div>

  <div class="hub-grid">
    <ProjectCard
      index="01"
      name="DoMarrow"
      kana="管理"
      status="live"
      domain="domarrow.app"
      href="https://domarrow.app"
      tone="paper"
      glyph="管"
      preview="https://domarrow.app"
      description="Project management for small teams: boards, sprints, and not much else."
      tags={['TypeScript', 'React', 'Node', 'Postgres']}
    />

    <ProjectCard
      index="02"
      name="MarrowTalk"
      kana="交流"
      status="live"
      domain="marrowtalk.com"
      href="https://marrowtalk.com"
      tone="talk"
      glyph="交"
      previewImage="/previews/marrowtalk.webp"
      description="A social space for short posts, community discussions, and real-time chat."
      tags={['React', 'TanStack Start', 'Cloudflare', 'WebSocket']}
    />

    <ProjectCard
      index="03"
      name="Ashen Omega"
      kana="残光"
      status="dev"
      domain="omega.marrowtech.app"
      href="https://omega.marrowtech.app"
      tone="obsidian"
      glyph="残"
      preview="https://omega.marrowtech.app"
      description="Real-time multiplayer. A Godot client, a server core in Rust and a Go API gluing it all together."
      tags={['Godot', 'Rust', 'Go', 'Multiplayer']}
    />

    <ProjectCard
      index="04"
      name="widing.dev"
      kana="履歴"
      status="live"
      domain="widing.dev"
      href="https://widing.dev"
      tone="ocean"
      glyph="履"
      previewImage="/previews/widing-dev.webp"
      cta="Read CV"
      description="My résumé: experience, tech stack, and how I got here."
      tags={['CV', 'About', 'Contact']}
    />

    <ProjectCard
      index="05"
      name="Vibe Translate"
      kana="翻訳"
      status="live"
      domain="translate.marrowtech.app"
      href="https://translate.marrowtech.app/"
      tone="translate"
      glyph="訳"
      previewImage="/previews/vibe-translate.webp"
      cta="Translate"
      description="Translation with control over tone, dialect, and formality, plus explanations of words and grammar."
      tags={['React', 'TypeScript', 'Cloudflare', 'AI']}
    />
  </div>
</section>
